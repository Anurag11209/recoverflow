generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Processor {
  RAZORPAY
  STRIPE
}

enum UserRole {
  OWNER
  MEMBER
}

enum PlanTier {
  STARTER
  GROWTH
  BUSINESS
  ENTERPRISE
}

// Mirrors the Stripe subscription statuses we act on. INCOMPLETE/PAST_DUE/
// CANCELED gate access; ACTIVE/TRIALING grant it.
enum BillingStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Merchant {
  id                    String    @id @default(cuid())
  name                  String
  email                 String    @unique
  processor             Processor @default(RAZORPAY)
  // Per-merchant webhook attribution (Phase 8 Step 0). webhookToken routes the
  // public webhook URL; razorpayWebhookSecret verifies that merchant's HMAC;
  // razorpayAccountId is captured trust-on-first-use and cross-checked after.
  // NOTE (Phase 9): encrypt razorpayWebhookSecret at rest.
  webhookToken          String    @unique @default(cuid())
  razorpayWebhookSecret String    @default("")
  razorpayAccountId     String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  users               User[]
  customers           Customer[]
  subscriptions       Subscription[]
  paymentEvents       PaymentEvent[]
  recoveryCases       RecoveryCase[]
  messageLogs         MessageLog[]
  paymentUpdateTokens PaymentUpdateToken[]
  auditLogs           AuditLog[]
  billingSubscription BillingSubscription?
}

model AuditLog {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  // Nullable: the acting user may be unavailable (e.g. system-initiated change).
  userId     String?
  // Stable action key, e.g. "profile.updated" or "webhook_secret.regenerated".
  action     String
  // Non-sensitive change context only. NEVER stores secret values.
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([merchantId, createdAt])
}

model User {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]

  @@index([merchantId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id                  String   @id @default(cuid())
  merchantId          String
  merchant            Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  processorCustomerId String?
  name                String?
  email               String?
  phone               String?
  locale              String   @default("en")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
  recoveryCases RecoveryCase[]

  @@unique([merchantId, processorCustomerId])
  @@index([merchantId])
}

model Subscription {
  id                      String   @id @default(cuid())
  merchantId              String
  merchant                Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId              String
  customer                Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  processorSubscriptionId String?
  status                  String?
  amount                  Int?
  currency                String   @default("INR")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  recoveryCases RecoveryCase[]

  @@index([merchantId])
  @@index([customerId])
}

// The MERCHANT'S OWN subscription to RecoverFlow (distinct from the dunning
// `Subscription` model above, which tracks a merchant's CUSTOMER'S subscription).
// One per merchant. Stripe fields are nullable until checkout (M4-2) populates them.
model BillingSubscription {
  id                   String        @id @default(cuid())
  merchantId           String        @unique
  merchant             Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  plan                 PlanTier      @default(STARTER)
  status               BillingStatus @default(INCOMPLETE)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status])
}

model PaymentEvent {
  id                String    @id @default(cuid())
  provider          String
  providerEventId   String
  eventType         String
  merchantId        String
  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  payload           Json
  signatureVerified Boolean
  eventTime         DateTime?
  receivedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  recoveryCase    RecoveryCase?
  eventProcessing EventProcessing?

  @@index([provider, providerEventId])
  @@index([merchantId])
  @@index([eventType])
}

model WebhookReceipt {
  id         String    @id @default(cuid())
  provider   String
  eventId    String
  eventType  String?
  eventTime  DateTime?
  receivedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@unique([provider, eventId])
}

enum RecoveryStatus {
  OPEN
  RECOVERED
  FAILED
  CLOSED
}

enum AttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

model RecoveryCase {
  id                String         @id @default(cuid())
  merchantId        String?
  merchant          Merchant?      @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subscriptionId    String?
  subscription      Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentEventId    String         @unique
  paymentEvent      PaymentEvent   @relation(fields: [paymentEventId], references: [id], onDelete: Restrict)
  provider          String
  providerPaymentId String?
  customerEmail     String?
  customerPhone     String?
  amount            Decimal?
  currency          String?
  failureReason     String?
  failureCategory   String?
  status            RecoveryStatus @default(OPEN)
  token             String         @unique @default(cuid())
  recoveredAmount   Decimal?
  createdAt         DateTime       @default(now())
  recoveredAt       DateTime?
  updatedAt         DateTime       @updatedAt

  attempts            RecoveryAttempt[]
  messageLogs         MessageLog[]
  paymentUpdateTokens PaymentUpdateToken[]

  @@index([merchantId, status])
  @@index([customerId])
  @@index([status])
  // Phase 8 Module 8 — dashboard scalability (100k+ rows):
  // cases list default sort + keyset pagination (merchantId, createdAt DESC, id DESC)
  @@index([merchantId, createdAt, id])
  // status-filtered cases list + ordering (supersedes the [merchantId, status] prefix)
  @@index([merchantId, status, createdAt])
  // analytics revenue trend (merchantId + recoveredAt range scan)
  @@index([merchantId, recoveredAt])
}

model RecoveryAttempt {
  id             String        @id @default(cuid())
  recoveryCaseId String
  recoveryCase   RecoveryCase  @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
  attemptNumber  Int
  status         AttemptStatus @default(PENDING)
  scheduledAt    DateTime
  executedAt     DateTime?
  failureReason  String?
  createdAt      DateTime      @default(now())

  messageLogs MessageLog[]

  @@unique([recoveryCaseId, attemptNumber])
  @@index([status, scheduledAt])
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum MessageType {
  PAYMENT_FAILED
  PAYMENT_REMINDER
  PAYMENT_RECOVERED
}

model MessageLog {
  id                String           @id @default(cuid())
  merchantId        String?
  merchant          Merchant?        @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  recoveryCaseId    String
  recoveryCase      RecoveryCase     @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
  recoveryAttemptId String?
  recoveryAttempt   RecoveryAttempt? @relation(fields: [recoveryAttemptId], references: [id], onDelete: Cascade)
  messageType       MessageType      @default(PAYMENT_FAILED)
  provider          String
  templateName      String
  recipientPhone    String?
  status            MessageStatus    @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  payload           Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([merchantId])
  @@index([recoveryCaseId])
  @@index([status])
}

model PaymentUpdateToken {
  id             String       @id @default(cuid())
  recoveryCaseId String
  recoveryCase   RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
  merchantId     String?
  merchant       Merchant?    @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  supersededAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([recoveryCaseId])
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

model EventProcessing {
  id             String           @id @default(cuid())
  paymentEventId String           @unique
  paymentEvent   PaymentEvent     @relation(fields: [paymentEventId], references: [id], onDelete: Cascade)
  status         ProcessingStatus @default(PENDING)
  attempts       Int              @default(0)
  lastError      String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

model IdempotencyRecord {
  id            String   @id @default(cuid())
  provider      String
  eventId       String
  eventType     String
  processingKey String
  createdAt     DateTime @default(now())

  @@unique([provider, eventId])
}
