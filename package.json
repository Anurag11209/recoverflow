{
  "name": "recoverflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:env": "dotenv -e .env -- tsx packages/shared/src/check-env.ts",
    "db:generate": "pnpm --filter @recoverflow/db run generate",
    "db:migrate": "pnpm --filter @recoverflow/db run migrate",
    "db:deploy": "pnpm --filter @recoverflow/db run deploy",
    "db:studio": "pnpm --filter @recoverflow/db run studio",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
