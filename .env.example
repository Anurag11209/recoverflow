# Node environment
NODE_ENV=development

# Public base URL of the web app (exposed to the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side canonical base URL for links in outbound messages (WhatsApp
# payment-update links). In production set to the public app origin, e.g.
# https://app.recoverflow.com . Defaults to localhost if unset.
APP_BASE_URL=http://localhost:3000

# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL=postgresql://recoverflow:recoverflow@localhost:5432/recoverflow?schema=public

# Razorpay webhook secrets are per-merchant (generated at registration, stored on
# the Merchant row); there is no global Razorpay secret here.

# Delivery backend for recovery messages AND password-reset emails.
#   console = dev logger (no real mail sent)
#   resend  = real email via Resend
# When set to 'resend', RESEND_API_KEY and EMAIL_FROM below become REQUIRED at
# boot (the app refuses to start without them).
MESSAGING_PROVIDER=console

# Resend transactional email. Only needed when MESSAGING_PROVIDER=resend.
# RESEND_API_KEY: from the Resend dashboard (starts with re_).
# EMAIL_FROM: a verified From identity on your Resend-verified sending domain.
#   Set up SPF/DKIM/DMARC for that domain first — see docs/deployment.md.
# RESEND_API_KEY=re_...
# EMAIL_FROM=RecoverFlow <no-reply@recoverflow.com>

# AES-256 key for encrypting per-merchant Razorpay webhook secrets at rest.
# REQUIRED: the app validates this at boot and refuses to start without a valid
# 32-byte key (missing or malformed fails fast). Generate with:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=<32-byte base64 key>

# Shared secret protecting the internal-only API routes (/api/internal/*).
# REQUIRED in every environment. Callers send it as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=<long-random-shared-secret>

# ---------------------------------------------------------------------------
# Worker (apps/worker) — drains PENDING EventProcessing rows through the recovery
# engine. All optional; these are the defaults. The worker also needs the shared
# vars above (DATABASE_URL, APP_ENCRYPTION_KEY, INTERNAL_API_TOKEN, APP_BASE_URL,
# MESSAGING_PROVIDER) since it calls getEnv() at boot.
# ---------------------------------------------------------------------------
# WORKER_CONCURRENCY=5
# WORKER_POLL_INTERVAL_MS=2000
# WORKER_MAX_ATTEMPTS=5
# WORKER_BACKOFF_BASE_MS=1000
# WORKER_BACKOFF_MAX_MS=300000
# WORKER_SHUTDOWN_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Stripe — RecoverFlow's OWN subscription billing (merchants paying us). All
# optional at load time; presence is enforced where actually used. The buttons
# on /dashboard/billing stay disabled ("not configured for checkout") until the
# matching STRIPE_PRICE_* is set. Price ids come from Products in the Stripe
# Dashboard; the webhook secret from `stripe listen` (local) or the Dashboard
# endpoint pointing at /api/webhooks/stripe (deployed).
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_BUSINESS=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Production (Railway) — set these in the Railway service Variables, not here.
# ---------------------------------------------------------------------------
# NODE_ENV=production
# DATABASE_URL is injected by Railway's Postgres plugin (reference variable):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Public origin of the deployed app (used for CSRF same-origin + browser):
#   NEXT_PUBLIC_APP_URL=https://app.recoverflow.com
# Server-side canonical origin for outbound WhatsApp payment-update links:
#   APP_BASE_URL=https://app.recoverflow.com
# APP_ENCRYPTION_KEY is REQUIRED (see above) — set it in the Railway service
# Variables. The server validates it at boot and will not start without a valid
# 32-byte base64 key.
# LOG_LEVEL=info
